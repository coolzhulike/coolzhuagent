# ============================================================================

# 全仓：换行按仓库内字节原样保留。本仓库若干测试用 include_str! 把 **LF 本身**当作被断言对象
# （例：modules/gui-web/packages/windows-process-guard/src/pipe.rs 的文本钉住断言），
# 检出时被转成 CRLF 会直接判红；因此统一声明 eol=lf，避免 core.autocrlf 在检出时改写工作区字节。
* text=auto eol=lf

# web-console 将前端资源以内嵌字符串编译进 Rust，契约测试按 LF 匹配多行片段。
/modules/gui-web/packages/web-console/src/app.js text eol=lf
/modules/gui-web/packages/web-console/src/styles.css text eol=lf

# 以下由 RD4（输入安全链 + PKG 完整性 + 安装准备）追加：与上一条同样的理由，
# 但**显式列出扩展名**，不依赖 `text=auto` 的探测结果（探测受内容启发式影响）。
*.rs text eol=lf
*.ps1 text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.png binary
*.ico binary
*.msi binary
*.dll binary
*.exe binary
*.sqlite3 binary

