+    struct DispatchHookGuard(Option<runtime::HookRunner>);
+    impl Drop for DispatchHookGuard {
+        fn drop(&mut self) {
+            *super::tool_dispatch_service::DISPATCH_HOOK_RUNNER_OVERRIDE
+                .lock()
+                .expect("hook override lock") = self.0.take();
+        }
