+
+function Resolve-IdentityTmpPath {
+  param(
+    [Parameter(Mandatory = $true)][string]$RepoPath,
+    [Parameter(Mandatory = $true)][string]$Relative
+  )
+  $sub = ($Relative -replace '^tmp[\\/]', '') -replace '/', '\'
