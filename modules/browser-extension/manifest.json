{
  "manifest_version": 3,
  "name": "Coolzhu Agent Browser Bridge",
  "version": "0.2.0",
  "description": "Generation-bound DOM bridge for Coolzhu Agent Computer Use.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service_worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Coolzhu Agent Browser Bridge"
  }
}
