{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoolzhuAgent",
  "version": "0.2.0",
  "identifier": "com.coolzhu.agent",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:8765"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app-icon-cz-moon-gate-lantern-v1.ico",
      "icons/app-icon-cz-moon-gate-lantern-v1.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "single-instance": null
  }
}
